# Local development: fixture mode is explicit and never records mastery.
SAYWITH_MODE=fixture
SAYWITH_DATABASE_URL=sqlite:///var/saywith.sqlite
SAYWITH_MEDIA_DIR=var/media
# Production: provider, PostgreSQL, TLS reverse proxy; keep keys server-side.
# SAYWITH_MODE=provider
# SAYWITH_DATABASE_URL=postgresql+psycopg://saywith:password@localhost:5432/saywith
SAYWITH_API_BASE=https://api.deepseek.com
SAYWITH_API_KEY=
SAYWITH_TEXT_MODEL=deepseek-v4-flash
SAYWITH_REVIEW_MODEL=deepseek-v4-flash
DOUBAO_API_KEY=
DOUBAO_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_SPEAKER=en_female_dacey_uranus_bigtts
SAYWITH_ADMIN_TOKEN=
SAYWITH_MAX_AUDIO_BYTES=10485760
SAYWITH_RETENTION_DAYS=7
SAYWITH_MAX_JOB_ATTEMPTS=3

# Required by Docker Compose; use a generated password.
SAYWITH_DB_PASSWORD=replace_with_a_random_password
