[Unit]
Description=SayWith personalized learning API
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/saywith-learning/current
EnvironmentFile=/opt/saywith-learning/.env
ExecStart=/opt/saywith-learning/venv/bin/python -m backend serve --host 127.0.0.1 --port 8083
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/saywith-learning/var

[Install]
WantedBy=multi-user.target
