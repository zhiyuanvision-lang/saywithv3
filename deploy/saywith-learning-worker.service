[Unit]
Description=SayWith personalized lesson worker
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/saywith-learning/current
EnvironmentFile=/opt/saywith-learning/.env
ExecStart=/opt/saywith-learning/venv/bin/python -m backend worker
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/saywith-learning/var

[Install]
WantedBy=multi-user.target
